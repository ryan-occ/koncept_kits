{
  "name": "vanguard-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node --enable-source-maps dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "openai": "^6.16.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.0",
    "pngjs": "^7.0.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
